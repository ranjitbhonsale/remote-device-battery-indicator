<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Battery Terminal Cap -->
    <path
        android:pathData="M48,27 h12 v4 h-12 z"
        android:fillColor="#FF94A3B8" />

    <!-- Battery Body Outer Frame -->
    <path
        android:pathData="M38,31 h32 a5,5 0 0 1 5,5 v42 a5,5 0 0 1 -5,5 h-32 a5,5 0 0 1 -5,-5 v-42 a5,5 0 0 1 5,-5 z"
        android:strokeColor="#FF38BDF8"
        android:strokeWidth="3.5"
        android:fillColor="#00000000" />

    <!-- Inner Battery Fill Level Gradient -->
    <path
        android:pathData="M40,50 h28 a2,2 0 0 1 2,2 v24 a2,2 0 0 1 -2,2 h-28 a2,2 0 0 1 -2,-2 v-24 a2,2 0 0 1 2,-2 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="40"
                android:startY="78"
                android:endX="68"
                android:endY="50"
                android:type="linear">
                <item android:color="#FF10B981" android:offset="0.0"/>
                <item android:color="#FF34D399" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Central Lightning Charging Bolt -->
    <path
        android:pathData="M56,36 L45,54 H53 L51,72 L63,52 H55 Z"
        android:fillColor="#FFF59E0B"
        android:strokeColor="#FFFFFBEB"
        android:strokeWidth="0.8" />

    <!-- Remote Broadcast Signal Waves (Right Side) -->
    <path
        android:pathData="M78,44 A18,18 0 0,1 78,64"
        android:strokeColor="#FF38BDF8"
        android:strokeWidth="2.8"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <path
        android:pathData="M83,39 A25,25 0 0,1 83,69"
        android:strokeColor="#FF10B981"
        android:strokeWidth="2.8"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
</vector>
